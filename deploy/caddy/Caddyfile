# Caddy als Reverse Proxy im Compose-Stack (Profil "proxy").
# /api/ geht an die API, alles andere an das Web-Frontend. Das Zertifikat stellt Caddy
# selbst aus, mit einer eigenen Zertifizierungsstelle (CA), die unter DATA_DIR/caddy liegt.
#
# Die Adressen kommen aus CADDY_SITES in der .env, z. B. "hiker.lacasa.internal".

{
	# Der Container läuft ohne root und mit schreibgeschütztem Dateisystem:
	# keine Ports unter 1024, keine Verwaltungsschnittstelle, keine gespeicherte Konfiguration.
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	# Clients, die den Server über seine IP-Adresse ansprechen, nennen keinen Namen.
	default_sni {$CADDY_DEFAULT_SNI:localhost}

	pki {
		ca local {
			name "hiker lokale CA"
			# Lange gültig, damit Geräte der CA nur einmal vertrauen müssen.
			intermediate_lifetime 3500d
		}
	}
}

{$CADDY_SITES:localhost} {
	tls {
		issuer internal {
			# Ein Jahr statt der üblichen zwölf Stunden: Die App merkt sich den
			# Fingerabdruck des Zertifikats und müsste sonst ständig neu fragen.
			lifetime 365d
		}
	}

	encode zstd gzip

	# Mehrere Fotos in einem Upload (MAX_UPLOAD_MB je Datei).
	request_body {
		max_size 320MB
	}

	header Strict-Transport-Security "max-age=31536000"

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Tokens öffentlicher Links sind Geheimnisse und dürfen nicht ins Log.
				request>uri regexp "(/p/|/api/v1/public/tours/)[^/?]+" "${1}[redacted]"
				# Die Unterseiten eines öffentlichen Links tragen das Token im Referer.
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:8000
	}
}
