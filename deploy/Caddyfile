# Beispiel für Caddy als Reverse Proxy vor hiker. Domain anpassen.
# /api/ geht an die API (API_PORT), alles andere an das Web-Frontend (WEB_PORT).

hiker.lacasa.internal {
	# Interne Domain: Zertifikat der eigenen Caddy-CA. Bei einer öffentlichen Domain diese
	# Zeile entfernen, dann holt Caddy das Zertifikat von Let's Encrypt.
	tls internal

	encode zstd gzip

	# Mehrere Fotos in einem Upload (MAX_UPLOAD_MB je Datei).
	request_body {
		max_size 320MB
	}

	header Strict-Transport-Security "max-age=31536000"

	log {
		output file /var/log/caddy/hiker.access.log
		format filter {
			wrap json
			fields {
				# Tokens öffentlicher Links sind Geheimnisse und dürfen nicht ins Log.
				request>uri regexp "(/p/|/api/v1/public/tours/)[^/?]+" "${1}[redacted]"
				# Die Unterseiten eines öffentlichen Links tragen das Token im Referer.
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8010
	}

	handle {
		reverse_proxy 127.0.0.1:8011
	}
}
