# Vorlage für .env (nicht ins Repository einchecken).
# Für Docker Compose: nach ./.env kopieren. Für lokale Entwicklung ohne Docker:
# nach backend/.env kopieren und DATABASE_URL setzen (siehe unten).

# Geheimer Schlüssel für die Token-Signatur, mindestens 32 Zeichen.
# Erzeugen mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Öffentliche Basis-URL (für Links), ohne Schrägstrich am Ende.
PUBLIC_BASE_URL=https://hiker.lacasa.internal

# Aktive Module, durch Komma getrennt. Abhängigkeiten müssen ebenfalls aktiv sein.
ENABLED_MODULES=auth,gear,nutrition,protocols,sync,maps,planning

# open = jeder kann ein Konto anlegen, closed = keine neuen Konten.
# Der erste registrierte Nutzer wird Admin; danach auf closed stellen.
REGISTRATION_MODE=open

# Zweiter Faktor (TOTP) ist Pflicht für die Anmeldung mit Passwort: nach dem ersten Login
# muss er eingerichtet werden. false = freiwillig.
MFA_REQUIRED=true

# --- Anmeldung über einen OpenID-Connect-Anbieter (SSO), optional ---
# Leer = abgeschaltet. Beim Anbieter als Redirect-URI eintragen:
#   <PUBLIC_BASE_URL>/login/sso/callback
# OIDC_ISSUER=https://sso.example.org/realms/home
# OIDC_CLIENT_ID=hiker
# OIDC_CLIENT_SECRET=
# Beschriftung des Knopfes auf der Anmeldeseite.
# OIDC_NAME=SSO
# OIDC_SCOPES=openid email profile
# Konten werden nur über eine vom Anbieter bestätigte E-Mail-Adresse verknüpft bzw. angelegt.
# OIDC_REQUIRE_VERIFIED_EMAIL=true

# --- Docker Compose ---
# Ordner für alle Daten (Datenbank, Fotos/GPX, Kartenkacheln, Web-Sitzungen) als normale Dateien.
DATA_DIR=./data
# Benutzer und Gruppe, unter denen alle Container laufen und denen die Dateien gehören
# (id -u / id -g). Kein Container läuft als root. DATA_DIR muss diesem Benutzer gehören.
HIKER_UID=1000
HIKER_GID=1000
POSTGRES_DB=hiker
POSTGRES_USER=hiker
# Nur Buchstaben und Ziffern verwenden (das Passwort wird in eine URL eingesetzt).
POSTGRES_PASSWORD=
# Port der API auf 127.0.0.1, Ziel des Reverse Proxy für /api/.
API_PORT=8010

# --- Reverse Proxy (Dienst caddy), optional ---
# Caddy nimmt HTTPS entgegen und stellt sich das Zertifikat selbst aus (eigene CA unter
# DATA_DIR/caddy). Einschalten mit dem Profil "proxy"; ohne die Zeile läuft kein Proxy im
# Stack, etwa weil der Server schon einen eigenen hat (Beispiele in deploy/).
# COMPOSE_PROFILES=proxy
# Namen und Adressen, unter denen hiker erreichbar ist, durch Komma getrennt.
# CADDY_SITES=hiker.lacasa.internal
# Zertifikat für Clients, die keinen Namen nennen (Zugriff über die IP-Adresse).
# CADDY_DEFAULT_SNI=hiker.lacasa.internal
# Port auf dem Server. Bei einem anderen Port als 443 gehört er in PUBLIC_BASE_URL.
# HTTPS_PORT=443
# Nur auf dieser Adresse lauschen, z. B. 127.0.0.1 für einen Test.
# HTTPS_BIND=0.0.0.0

# --- Web-Frontend (Dienst web) ---
# Signiert das Sitzungs-Cookie, mindestens 32 Zeichen, ein anderer Wert als SECRET_KEY.
# Erzeugen mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=
# Port des Web-Frontends auf 127.0.0.1, Ziel des Reverse Proxy für alles außer /api/.
WEB_PORT=8011
# Nur für einen Test ohne HTTPS (direkt über http://127.0.0.1:WEB_PORT) auf false stellen.
# WEB_COOKIE_SECURE=true
# Kachelquelle der Karte im Web-Frontend. Leer = Kacheln vom eigenen Server (Modul maps).
# MAP_TILE_URL=

# --- Kartenkacheln (Modul maps) ---
# Der Server holt jede Kachel beim ersten Ansehen und liefert sie danach selbst aus.
# Nach TILE_CACHE_DAYS Tagen fragt er die Quelle, ob sich die Kachel geändert hat (mindestens 7).
# TILE_CACHE_DAYS=14
# Obergrenze des Kachelspeichers in MB; darüber fallen die ältesten Kacheln weg.
# TILE_CACHE_MAX_MB=2000

# --- Lokale Entwicklung ohne Docker (backend/.env) ---
# DATABASE_URL=sqlite:///./hiker-dev.db

# STORAGE_PATH=./data/files
# TILE_CACHE_PATH=./data/tiles
# Quelle der Kartenkacheln; leerer Wert schaltet das Nachladen ab.
# TILE_SOURCE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional (Standardwerte):
# RATE_LIMIT_ENABLED=true
# MAX_UPLOAD_MB=15
# IMAGE_MAX_EDGE_PX=2000
# Barcode-Suche bei Open Food Facts; leerer Wert schaltet sie ab.
# OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
# OPENFOODFACTS_CACHE_DAYS=30
# Höhenabfrage für Tracks ohne Höhe; leerer Wert schaltet sie ab.
# OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# Gipfel und Pässe am Track aus OpenStreetMap; leerer Wert schaltet die Abfrage ab.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Wie nah eine Stelle an der Tracklinie liegen muss (Meter).
# PLACE_MAX_DISTANCE_M=10
# Wetterabruf (Vorhersage und Archiv); leere Werte schalten ihn ab.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30

# Routenplanung (Modul planning): Wegführung über den eigenen BRouter.
# Leer = nur Luftlinien. Einschalten: das Profil "routing" zu COMPOSE_PROFILES hinzufügen
# (z. B. COMPOSE_PROFILES=proxy,routing), die Wegdaten mit deploy/brouter-segments.sh holen
# und BROUTER_URL setzen.
# BROUTER_URL=http://brouter:17777
# BRouter-Profil für das Wandern; hiker-hiking (deploy/brouter/profiles) kennt die
# Schwierigkeit (T1–T6) und Klettersteige.
# BROUTER_PROFILE_HIKING=hiker-hiking

# Kartenebenen aus offenen Quellen, über den eigenen Server geholt und zwischengespeichert.
# Höhendaten (Mapzen Terrain Tiles, AWS Open Data) für Schummerung, 3D und Hangneigung.
# TERRAIN_ENABLED=true
# Luftbild (swisstopo, basemap.at, Sentinel-2 cloudless 2016).
# SATELLITE_ENABLED=true
# Lawinengefahr der europäischen Warndienste (über avalanche.report).
# AVALANCHE_ENABLED=true
# Schneebedeckung und Niederschlag aus Satellitendaten (NASA GIBS).
# WEATHER_LAYERS_ENABLED=true

# Eigene Karte aus OpenStreetMap-Daten: deploy/build-map.sh <gebiet> baut sie nach
# DATA_DIR/maps. Speicher und Kerne für den Bau (Alpen: 6g).
# MAP_BUILD_MEMORY=3g
# MAP_BUILD_CPUS=2.0

